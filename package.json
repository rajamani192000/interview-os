{
  "name": "interview-os",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit && npm run e2e",
    "env": "node scripts/set-env.mjs",
    "test:unit": "vitest run --config vitest.config.mts",
    "build:e2e": "ng build --configuration e2e",
    "e2e": "npm run build:e2e && playwright test",
    "build:pages": "ng build --configuration production,pages && node scripts/postbuild.mjs",
    "build:prod": "ng build --configuration production && node scripts/postbuild.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "firebase": "^12.19.0",
    "papaparse": "^5.5.3",
    "read-excel-file": "^5.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.63.0",
    "@types/papaparse": "^5.3.16",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}